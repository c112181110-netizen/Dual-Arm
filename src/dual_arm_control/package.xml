<?xml version="1.0"?>
<package format="3">
  <name>dual_arm_control</name><version>0.1.0</version>
  <description>ROS 2 task control, MoveIt client and CM530 protocol 5 bridge.</description>
  <maintainer email="maintainer@example.com">Dual arm team</maintainer><license>BSD-3-Clause</license>
  <buildtool_depend>ament_python</buildtool_depend>
  <exec_depend>rclpy</exec_depend><exec_depend>vision_interfaces</exec_depend>
  <exec_depend>dual_arm_interfaces</exec_depend><exec_depend>moveit_msgs</exec_depend>
  <exec_depend>control_msgs</exec_depend><exec_depend>sensor_msgs</exec_depend>
  <exec_depend>geometry_msgs</exec_depend><exec_depend>shape_msgs</exec_depend>
  <exec_depend>std_srvs</exec_depend><exec_depend>std_msgs</exec_depend>
  <exec_depend>trajectory_msgs</exec_depend><exec_depend>action_msgs</exec_depend>
  <exec_depend>launch_ros</exec_depend><exec_depend>ament_index_python</exec_depend>
  <exec_depend>python3-serial</exec_depend><exec_depend>python3-yaml</exec_depend>
  <exec_depend>dual_arm_description</exec_depend><exec_depend>robot_state_publisher</exec_depend>
  <exec_depend>moveit_ros_move_group</exec_depend><exec_depend>moveit_kinematics</exec_depend>
  <exec_depend>moveit_planners_ompl</exec_depend><exec_depend>moveit_simple_controller_manager</exec_depend>
  <test_depend>python3-pytest</test_depend>
  <export><build_type>ament_python</build_type></export>
</package>
